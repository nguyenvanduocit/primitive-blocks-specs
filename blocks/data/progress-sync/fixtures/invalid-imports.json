{
  "_comment": "Import validation cases. `base` is local-record.json; each case applies `patch` (ops: set <path> <value>; generate_entries <count> = replace history with that many valid entries and set history.seq) or supplies `text`/`generate_text_length` directly. `expect.error` is the first error path validate() must report (indices in paths are zero-based; the UI shows them one-based). On any `ok: false` the existing data must be unchanged. Verified against the source app's validator through a field-name mapping (see README, Origin).",
  "base": "local-record.json",
  "cases": [
    {
      "id": "root-is-array",
      "why": "Root must be an object",
      "text": "[]",
      "expect": {
        "ok": false,
        "error": "not an object"
      }
    },
    {
      "id": "malformed-json",
      "why": "Truncated file",
      "text": "{\"history\": ",
      "expect": {
        "ok": false,
        "error": "not valid JSON"
      }
    },
    {
      "id": "over-size-limit",
      "why": "Text longer than MAX_IMPORT_CHARS is refused before parsing",
      "generate_text_length": 5242881,
      "expect": {
        "ok": false,
        "error": "too large"
      }
    },
    {
      "id": "history-over-cap",
      "why": "MAX_HISTORY + 1 entries",
      "patch": [
        {
          "op": "generate_entries",
          "count": 20001
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.entries"
      }
    },
    {
      "id": "entry-seq-not-position",
      "why": "seq must equal position (i + 1)",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[1].seq",
          "value": 5
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.entries[1].seq"
      }
    },
    {
      "id": "entry-grade-mismatch",
      "why": "ok must equal (value == answer_key[ref]); entry 0 chose the key",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[0].ok",
          "value": false
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.entries[0].ok"
      }
    },
    {
      "id": "entry-unknown-ref",
      "why": "ref not in the app's reference set",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[2].ref",
          "value": "q-999"
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.entries[2].ref"
      }
    },
    {
      "id": "entry-value-not-allowed",
      "why": "value outside the allowed set A-E",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[0].value",
          "value": "Z"
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.entries[0].value"
      }
    },
    {
      "id": "entry-duration-not-a-number",
      "why": "ms must be a finite number",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[0].ms",
          "value": "12"
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.entries[0].ms"
      }
    },
    {
      "id": "entry-duration-over-one-day",
      "why": "ms above MAX_ELAPSED_MS (86400000)",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[0].ms",
          "value": 86400001
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.entries[0].ms"
      }
    },
    {
      "id": "entry-time-back-more-than-a-day",
      "why": "at earlier than the latest earlier at by more than AT_SKEW_MS",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[2].at",
          "value": 1789900060000
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.entries[2].at"
      }
    },
    {
      "id": "entry-time-back-within-a-day",
      "why": "a clock set back a little is fine",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[2].at",
          "value": 1789990060000
        }
      ],
      "expect": {
        "ok": true
      }
    },
    {
      "id": "entry-time-at-2100",
      "why": "at must be below MAX_AT (4102444800000)",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[2].at",
          "value": 4102444800000
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.entries[2].at"
      }
    },
    {
      "id": "count-mismatch",
      "why": "history.seq must equal entries.length",
      "patch": [
        {
          "op": "set",
          "path": "history.seq",
          "value": 5
        }
      ],
      "expect": {
        "ok": false,
        "error": "history.seq mismatch"
      }
    },
    {
      "id": "marks-duplicate",
      "why": "a ref may be flagged once",
      "patch": [
        {
          "op": "set",
          "path": "marks",
          "value": [
            "q-002",
            "q-002"
          ]
        }
      ],
      "expect": {
        "ok": false,
        "error": "marks duplicate"
      }
    },
    {
      "id": "marks-unknown-ref",
      "why": "flagged ref must be known",
      "patch": [
        {
          "op": "set",
          "path": "marks",
          "value": [
            "q-999"
          ]
        }
      ],
      "expect": {
        "ok": false,
        "error": "marks"
      }
    },
    {
      "id": "collection-duplicate-source",
      "why": "sources may not repeat a value",
      "patch": [
        {
          "op": "set",
          "path": "collection[0].sources",
          "value": [
            "glossary",
            "glossary"
          ]
        }
      ],
      "expect": {
        "ok": false,
        "error": "collection[0].sources"
      }
    },
    {
      "id": "collection-duplicate-normalized-key",
      "why": "'Ratio' and ' QUOTIENT ' - second entry normalizes to the first entry's key",
      "patch": [
        {
          "op": "set",
          "path": "collection[1].key",
          "value": " QUOTIENT "
        }
      ],
      "expect": {
        "ok": false,
        "error": "collection[1] duplicate"
      }
    },
    {
      "id": "collection-key-too-long",
      "why": "key of 121 characters (MAX_KEY_CHARS is 120)",
      "patch": [
        {
          "op": "set",
          "path": "collection[0].key",
          "value": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
        }
      ],
      "expect": {
        "ok": false,
        "error": "collection[0].key"
      }
    },
    {
      "id": "collection-key-blank",
      "why": "key empty after trim",
      "patch": [
        {
          "op": "set",
          "path": "collection[0].key",
          "value": "   "
        }
      ],
      "expect": {
        "ok": false,
        "error": "collection[0].key"
      }
    },
    {
      "id": "note-over-limit",
      "why": "note of 20001 characters (MAX_TEXT is 20000)",
      "patch": [
        {
          "op": "set",
          "path": "notes.q-002",
          "value": ""
        }
      ],
      "expect": {
        "ok": false,
        "error": "notes.q-002"
      }
    },
    {
      "id": "note-at-limit",
      "why": "note of exactly 20000 characters is accepted",
      "patch": [
        {
          "op": "set",
          "path": "notes.q-002",
          "value": ""
        }
      ],
      "expect": {
        "ok": true
      }
    },
    {
      "id": "prefs-unknown-language",
      "why": "prefs.lang outside the supported set (en, vi)",
      "patch": [
        {
          "op": "set",
          "path": "prefs.lang",
          "value": "xx"
        }
      ],
      "expect": {
        "ok": false,
        "error": "prefs.lang"
      }
    },
    {
      "id": "milestones-level-out-of-range",
      "why": "level 0",
      "patch": [
        {
          "op": "set",
          "path": "milestones.level",
          "value": 0
        }
      ],
      "expect": {
        "ok": false,
        "error": "milestones"
      }
    },
    {
      "id": "milestones-newer-version-kept",
      "why": "a section written by a newer client (v above the known version) is accepted untouched",
      "patch": [
        {
          "op": "set",
          "path": "milestones",
          "value": {
            "v": 2,
            "anything": [
              "a",
              "b"
            ]
          }
        }
      ],
      "expect": {
        "ok": true
      }
    },
    {
      "id": "unknown-top-level-key-kept",
      "why": "unknown keys survive import",
      "patch": [
        {
          "op": "set",
          "path": "feature_y",
          "value": 1
        }
      ],
      "expect": {
        "ok": true,
        "preserved_keys": [
          "feature_x",
          "feature_y"
        ]
      }
    }
  ]
}
