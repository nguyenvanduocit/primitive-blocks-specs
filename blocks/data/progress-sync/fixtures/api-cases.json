            }
          }
        }
      ]
    },
    {
      "id": "snapshot-not-json",
      "steps": [
        {
          "as": "acct-0001",
          "method": "PUT",
          "path": "/api/progress/snapshot",
          "body": {
            "snapshot": "{broken",
            "format_version": 1,
            "base_revision": 0
          },
          "expect": {
            "status": 422,
            "body": {
              "error": "invalid_snapshot"
            }
          }
        }
      ]
    },
    {
      "id": "snapshot-json-array",
      "steps": [
        {
          "as": "acct-0001",
          "method": "PUT",
          "path": "/api/progress/snapshot",
          "body": {
            "snapshot": "[]",
            "format_version": 1,
            "base_revision": 0
          },
          "expect": {
            "status": 422,
            "body": {
              "error": "invalid_snapshot"
            }
          }
        }
      ]
    },
    {
      "id": "unsupported-format-version",
      "steps": [
        {
          "as": "acct-0001",
          "method": "PUT",
          "path": "/api/progress/snapshot",
          "body": {
            "snapshot": "{}",
            "format_version": 2,
            "base_revision": 0
          },
          "expect": {
            "status": 422,
            "body": {
              "error": "unsupported_format_version"
            }
          }
        }
      ]
    },
    {
      "id": "malformed-envelope",
      "steps": [
        {
          "as": "acct-0001",
          "method": "PUT",
          "path": "/api/progress/snapshot",
          "body": {
            "snapshot": {
              "history": 1
            },
            "format_version": 1,
            "base_revision": 0
          },
          "expect": {
            "status": 400,
            "body": {
              "error": "invalid_request"
            }
          }
        },
        {
          "as": "acct-0001",
          "method": "PUT",
          "path": "/api/progress/snapshot",
          "body": {
            "snapshot": "{}",
            "format_version": 1,
            "base_revision": -1
          },
          "expect": {
            "status": 400,
            "body": {
              "error": "invalid_request"
            }
          }
        }
      ]
    },
    {
      "id": "account-id-in-body-is-ignored",
      "why": "The session says acct-0001; the body names acct-0002",
      "steps": [
        {
          "as": "acct-0001",
          "method": "PUT",
          "path": "/api/progress/snapshot",
          "body": {
            "snapshot_json": {
              "history": {
                "seq": 0,
                "entries": []
              },
              "marks": []
            },
            "format_version": 1,
            "base_revision": 0
          },
          "account_id_in_body": "acct-0002",
          "expect": {
            "status": 200,
            "body": {
              "revision": 1
            }
          }
        },
        {
          "as": "acct-0002",
          "method": "GET",
          "path": "/api/progress/snapshot",
          "expect": {
            "status": 404,
            "body": {
              "error": "no_snapshot"
            }
          }
        },
        {
          "as": "acct-0001",
          "method": "GET",
          "path": "/api/progress/snapshot",
          "expect": {
            "status": 200,
            "body": {
              "revision": 1
            }
          }
        }
      ]
    },
    {
      "id": "accounts-are-isolated",
      "steps": [
        {
          "as": "acct-0001",
          "method": "PUT",
          "path": "/api/progress/snapshot",
          "body": {
            "snapshot_json": {
              "history": {
                "seq": 0,
                "entries": []
              },
              "marks": []
            },
            "format_version": 1,
            "base_revision": 0
          },
          "expect": {
            "status": 200,
            "body": {
              "revision": 1
            }
          }
        },
        {
          "as": "acct-0002",
          "method": "GET",
          "path": "/api/progress/snapshot",
          "expect": {
            "status": 404,
            "body": {
              "error": "no_snapshot"
            }
          }
        },
        {
          "as": "acct-0002",
          "method": "DELETE",
          "path": "/api/progress/snapshot",
          "expect": {
            "status": 204
          }
        },
        {
          "as": "acct-0001",
          "method": "GET",
          "path": "/api/progress/snapshot",
          "expect": {
            "status": 200,
            "body": {
              "revision": 1
            }
          }
        }
      ]
    },
    {
      "id": "delete-is-idempotent",
      "steps": [
        {
          "as": "acct-0001",
          "method": "PUT",
          "path": "/api/progress/snapshot",
          "body": {
            "snapshot_json": {
              "history": {
                "seq": 0,
                "entries": []
              },
              "marks": []
            },
            "format_version": 1,
            "base_revision": 0
          },
          "expect": {
            "status": 200,
            "body": {
              "revision": 1
            }
          }
        },
        {
          "as": "acct-0001",
          "method": "DELETE",
          "path": "/api/progress/snapshot",
          "expect": {
            "status": 204
          }
        },
        {
          "as": "acct-0001",
          "method": "DELETE",
          "path": "/api/progress/snapshot",
          "expect": {
            "status": 204
          }
        },
        {
          "as": "acct-0001",
          "method": "GET",
          "path": "/api/progress/snapshot",
          "expect": {
            "status": 404,
            "body": {
              "error": "no_snapshot"
            }
          }
        }
      ]
    },
    {
