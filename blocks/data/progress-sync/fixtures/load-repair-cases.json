{
  "_comment": "Load-time repair cases (INV-3, INV-7). `base` is local-record.json. Each case stores the patched record (or `stored_text`) under STORE_KEY, then loads it. `expect` lists the properties that must hold after load; nothing may throw. Verified against the source app's load path through a field-name mapping (README, Origin).",
  "base": "local-record.json",
  "cases": [
    {
      "id": "unparsable-text",
      "why": "Stored text is not JSON: whole record falls back to defaults, no exception",
      "stored_text": "{\"history\": ",
      "expect": {
        "history_refs": [],
        "history_seq": 0,
        "marks": [],
        "collection_keys": [],
        "prefs_lang": "en"
      }
    },
    {
      "id": "stored-root-is-array",
      "why": "Stored root is not an object",
      "stored_text": "[1,2,3]",
      "expect": {
        "history_refs": [],
        "history_seq": 0
      }
    },
    {
      "id": "entry-with-unknown-ref-dropped",
      "why": "One entry names a ref the app no longer has: only that entry is dropped, seq renumbered",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[1].ref",
          "value": "q-999"
        }
      ],
      "expect": {
        "history_refs": [
          "q-001",
          "q-003"
        ],
        "history_seq": 2,
        "entry_seqs": [
          1,
          2
        ]
      }
    },
    {
      "id": "entry-regraded",
      "why": "ok recomputed from the current answer key",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[1].ok",
          "value": true
        },
        {
          "op": "set",
          "path": "history.entries[1].value",
          "value": "D"
        }
      ],
      "expect": {
        "history_ok": [
          true,
          true,
          true
        ]
      }
    },
    {
      "id": "duration-capped",
      "why": "ms above one day is capped at MAX_ELAPSED_MS; the entry stays",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[0].ms",
          "value": 999999999
        }
      ],
      "expect": {
        "history_ms": [
          86400000,
          3400,
          900
        ]
      }
    },
    {
      "id": "backward-time-dropped",
      "why": "an `at` more than AT_SKEW_MS before the latest earlier `at` is dropped; the entry stays undated",
      "patch": [
        {
          "op": "set",
          "path": "history.entries[2].at",
          "value": 1789900060000
        }
      ],
      "expect": {
        "history_refs": [
          "q-001",
          "q-002",
          "q-003"
        ],
        "entry_has_at": [
          true,
          true,
          false
        ]
      }
    },
    {
      "id": "history-over-cap-keeps-newest",
      "why": "20003 valid entries: the newest 20000 are kept, seq renumbered 1..20000, nothing else is reset",
      "patch": [
        {
          "op": "generate_entries",
          "count": 20003
        }
      ],
      "expect": {
        "history_seq": 20000,
        "first_kept_original_position": 4,
        "marks": [
          "q-002"
        ]
      }
    },
    {
      "id": "marks-repaired",
      "why": "duplicate and unknown refs are removed",
      "patch": [
        {
          "op": "set",
          "path": "marks",
          "value": [
            "q-002",
            "q-002",
            "q-999"
          ]
        }
      ],
      "expect": {
        "marks": [
          "q-002"
        ]
      }
    },
    {
      "id": "collection-repaired",
      "why": "entry 0 (key of 121 chars) dropped; entry 1 meaning truncated to 400 and unknown source removed; entry 2 has the same normalized key as entry 1: merged into one entry whose sources are the union",
      "patch": [
        {
          "op": "set",
          "path": "collection",
          "value": [
            {
              "key": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk",
              "meaning": "x",
              "sources": []
            },
            {
              "key": "Ratio",
              "meaning": "",
              "sources": [
                "glossary",
                "bogus",
                "glossary"
              ]
            },
            {
              "key": "ratio",
              "meaning": "y",
              "sources": [
                "api"
              ]
            }
          ]
        }
      ],
      "expect": {
        "collection_keys": [
          "Ratio"
        ],
        "collection_meaning_length": [
          400
        ],
        "collection_sources": [
          [
            "glossary",
            "api"
          ]
        ]
      }
    },
    {
      "id": "prefs-invalid-falls-back-alone",
      "why": "Invalid prefs become the default; every other section is kept",
      "patch": [
        {
          "op": "set",
          "path": "prefs.lang",
          "value": "xx"
        }
      ],
      "expect": {
        "history_seq": 3,
        "marks": [
          "q-002"
        ],
        "prefs_lang": "en"
      }
    },
    {
      "id": "note-over-limit-dropped",
      "why": "A note of 20001 characters is dropped; other notes stay",
      "patch": [
        {
          "op": "set",
          "path": "notes",
          "value": {
            "q-001": "ok",
            "q-002": ""
          }
        }
      ],
      "expect": {
        "notes_keys": [
          "q-001"
        ]
      }
    },
    {
      "id": "milestones-invalid-dropped",
      "why": "An invalid milestones section is removed (the feature then uses its defaults)",
      "patch": [
        {
          "op": "set",
          "path": "milestones.level",
          "value": 0
        }
      ],
      "expect": {
        "milestones": null,
        "history_seq": 3
      }
    },
    {
      "id": "milestones-newer-version-untouched",
      "why": "A section from a newer client is kept exactly as stored",
      "patch": [
        {
          "op": "set",
          "path": "milestones",
          "value": {
            "v": 2,
            "anything": [
              "a",
              "b"
            ]
          }
        }
      ],
      "expect": {
        "milestones": {
          "v": 2,
          "anything": [
            "a",
            "b"
          ]
        }
      }
    },
    {
      "id": "unknown-keys-survive",
      "why": "Unknown top-level keys are kept through load",
      "patch": [],
      "expect": {
        "kept_keys": [
          "feature_x",
          "cloud"
        ]
      }
    }
  ]
}
