{
  "_comment": "Lifecycle sweep, reactivation, deletion and offline-queue cases for lifecycle-and-recovery.feature, switch-and-delete.feature and guest-issuance.feature (README sections 3.1, 3.5, 3.9). Day boundaries are computed from the clock: 90 days before the clock is 2026-07-29T12:00:00Z, 365 days before is 2025-10-27T12:00:00Z, 30 days before is 2026-09-27T12:00:00Z. All data is example data.",
  "_usage": "Seed the listed accounts, run the sweep at `clock` with `config`, assert `expected`. Paid holdings come from a participant stub named in `holdings`.",

  "clock": "2026-10-27T12:00:00Z",
  "tenant_id": "tenant-001",
  "config": {
    "GUEST_DORMANT_AFTER_DAYS": 90,
    "GUEST_PURGE_AFTER_DAYS": 365,
    "GUEST_PURGE_EXEMPT_PAID": true,
    "GUEST_ABANDONED_RETENTION_DAYS": 30,
    "GUEST_TOMBSTONE_RETENTION_DAYS": 365
  },

  "sweep_cases": [
    { "name": "recent launch",                 "kind": "guest", "status": "active",    "last_active_at": "2026-10-20T12:00:00Z", "holdings": "none",
      "expected": { "status": "active", "events": [] } },
    { "name": "89 days idle",                  "kind": "guest", "status": "active",    "last_active_at": "2026-07-30T12:00:00Z", "holdings": "none",
      "expected": { "status": "active", "events": [] } },
    { "name": "exactly 90 days idle",          "kind": "guest", "status": "active",    "last_active_at": "2026-07-29T12:00:00Z", "holdings": "none",
      "expected": { "status": "dormant", "dormant_at": "2026-10-27T12:00:00Z", "events": [{ "name": "guest_dormant", "inactive_days": 90, "paid_hold": false }] } },
    { "name": "dormant, 364 days idle",        "kind": "guest", "status": "dormant",   "last_active_at": "2025-10-28T12:00:00Z", "holdings": "none",
      "expected": { "status": "dormant", "events": [] } },
    { "name": "dormant, 365 days idle",        "kind": "guest", "status": "dormant",   "last_active_at": "2025-10-27T12:00:00Z", "holdings": "none",
      "expected": { "action": "purge", "erasers_called": "every registered block", "accounts_row": "deleted", "tombstones_written": [{ "reason": "inactive", "expires_at": "2027-10-27T12:00:00Z" }], "events": [{ "name": "guest_purged", "reason": "inactive", "has_account_id": false }] } },
    { "name": "dormant, 365 days idle, paid holding", "kind": "guest", "status": "dormant", "last_active_at": "2025-10-27T12:00:00Z", "holdings": "paid-currency",
      "expected": { "status": "dormant", "action": "skipped: paid_hold", "events": [] } },
    { "name": "dormant, 365 days idle, participant did not answer", "kind": "guest", "status": "dormant", "last_active_at": "2025-10-27T12:00:00Z", "holdings": "error",
      "expected": { "status": "dormant", "action": "skipped: treated as paid", "counter": "purge_skipped_unknown_holdings" } },
    { "name": "abandoned 29 days",             "kind": "guest", "status": "abandoned", "abandoned_at": "2026-09-28T12:00:00Z", "holdings": "none",
      "expected": { "status": "abandoned", "events": [] } },
    { "name": "abandoned 30 days",             "kind": "guest", "status": "abandoned", "abandoned_at": "2026-09-27T12:00:00Z", "holdings": "none",
      "expected": { "action": "purge", "tombstones_written": [{ "reason": "abandoned" }], "events": [{ "name": "guest_purged", "reason": "abandoned", "has_account_id": false }] } },
    { "name": "linked account idle 400 days",  "kind": "linked", "status": "active",   "last_active_at": "2025-09-22T12:00:00Z", "holdings": "none",
      "expected": { "status": "active", "action": "none", "note": "inactivity retention of linked accounts is outside this block" } },
    { "name": "launch while the purge transaction runs", "kind": "guest", "status": "dormant", "last_active_at": "2025-10-27T12:00:00Z", "holdings": "none",
      "during_purge": { "last_active_at_becomes": "2026-10-27T12:00:01Z" },
      "expected": { "status": "active", "action": "purge skipped", "note": "last_active_at is re-read inside the purge transaction" } }
  ],

  "reactivation": {
    "account": { "kind": "guest", "status": "dormant", "last_active_at": "2026-07-01T00:00:00Z", "dormant_at": "2026-09-29T00:00:00Z" },
    "exchange_at": "2026-10-27T12:00:00Z",
    "expected": { "status": 200, "reactivated": true, "account_status": "active", "dormant_at": null, "last_active_at": "2026-10-27T12:00:00Z", "events": [{ "name": "guest_reactivated", "dormant_days": 28 }] }
  },

  "tombstone_expiry": [
    { "created_at": "2025-10-27T11:00:00Z", "expires_at": "2026-10-27T11:00:00Z", "swept": true,  "then_exchange": { "status": 401, "error": "credential_invalid" } },
    { "created_at": "2025-10-28T11:00:00Z", "expires_at": "2026-10-28T11:00:00Z", "swept": false, "then_exchange": { "status": 410, "error": "guest_purged" } }
  ],

  "deletion_cases": [
    {
      "name": "guest deletes the account",
      "account": "guest", "proof": "device secret presented with the single-use deletion challenge",
      "expected": {
        "erasers_called": "every registered block",
        "accounts_row": "deleted (cascade: credentials, sessions, link attempts)",
        "tombstones_written": [{ "reason": "deleted" }],
        "client_cleanup": ["secure storage entry", "Block Store entry with shouldBackupToCloud false", "synchronizable Keychain item (all copies)"],
        "later_exchange_with_old_secret": { "status": 410, "error": "guest_purged", "reason": "deleted" }
      }
    },
    {
      "name": "guest deletion with the wrong secret",
      "account": "guest", "proof": "a secret that does not match",
      "expected": { "status": 401, "changed": "nothing" }
    },
    {
      "name": "guest deletion replayed with a used challenge",
      "account": "guest", "proof": "valid secret, challenge already used",
      "expected": { "status": 401, "changed": "nothing" }
    },
    {
      "name": "linked account deletion",
      "account": "linked", "proof": "provider proof (compliance.account-deletion)",
      "expected": { "order": ["erasers", "users row deleted", "accounts row deleted"], "tombstones_written": [{ "reason": "deleted", "for": "every retired device credential hash" }] }
    },
    {
      "name": "web deletion page for a guest",
      "account": "guest", "proof": "recovery code",
      "expected": { "result": "deleted", "note": "a guest without a code uses the in-app path" }
    }
  ],

  "offline_cases": {
    "queue_cap": 3,
    "events": [
      { "type": "tutorial_step_completed", "step_id": "s1", "client_ts": 1790000000000 },
      { "type": "tutorial_step_completed", "step_id": "s2", "client_ts": 1790000060000 },
      { "type": "first_win", "client_ts": 1790000120000 },
      { "type": "level_completed", "client_ts": 1790000180000 }
    ],
    "expected_enqueue": { "kept": 3, "dropped": 1 },
    "creation_backoff_seconds": [5, 30, 120, 600, 600],
    "receiving_block_decisions": [
      { "event": "tutorial_step_completed:s1", "idempotency_key": "tutorial:<account_id>:s1", "result": "applied" },
      { "event": "tutorial_step_completed:s2", "idempotency_key": "tutorial:<account_id>:s2", "result": "applied" },
      { "event": "first_win", "result": "rejected", "reason": "window_closed" }
    ],
    "expected_drain": { "dropped": 1 },
    "client_clock_decides": "nothing: client_ts orders the queue only"
  },

  "creation_replay": {
    "request_id": "req-replay-01",
    "first_response_lost": true,
    "retry_at": "2026-10-27T11:55:00Z",
    "created_at": "2026-10-27T11:50:00Z",
    "window_minutes": 15,
    "expected": { "status": 201, "same_account_id": true, "new_secret": true, "first_secret": "retired:rotated", "accounts_created": 1 },
    "after_window": { "retry_at": "2026-10-27T12:10:00Z", "expected": { "status": 409, "error": "request_consumed" } },
    "after_first_exchange": { "expected": { "status": 409, "error": "request_consumed" } }
  }
}
