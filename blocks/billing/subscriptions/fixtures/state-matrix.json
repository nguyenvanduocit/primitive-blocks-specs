        "chain": {"state": "trial", "will_renew": true, "term_is_newest": true},
        "stored": {"reminder_seq": 0, "reminder_ends_at": null},
        "expected_events": [{"subject_key": "trial:term-001:0", "state": "armed", "fire_at": "2026-11-01T12:00:00Z", "expires_at": "2026-11-03T12:00:00Z", "params": {"plan_code": "vip-monthly-apple", "product_code": "vip", "platform": "apple", "period": "P1M", "renews_at": "2026-11-03T12:00:00Z", "price_milliunits": 9990, "currency_code": "USD"}}]
