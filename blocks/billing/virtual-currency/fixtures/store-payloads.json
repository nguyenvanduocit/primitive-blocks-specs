  "expected_plans": [
    {
      "payload": "apple_transactions.gems_medium_purchase",
      "expect": {
        "state": "verified",
        "environment": "production"
      }
    },
    {
      "payload": "apple_transactions.gems_medium_sandbox",
      "expect": {
        "state": "verified",
        "environment": "sandbox"
      }
    },
    {
      "payload": "apple_transactions.gems_medium_sandbox",
      "config": {
        "APPLE_ACCEPT_SANDBOX": false
      },
      "expect": {
        "state": "rejected",
        "reason": "environment_not_accepted"
      }
    },
    {
      "payload": "apple_transactions.gems_medium_refunded",
      "expect": {
        "state": "refunded"
      }
    },
    {
      "payload": "apple_transactions.gems_medium_wrong_type",
      "expect": {
        "state": "rejected",
        "reason": "type_mismatch"
      }
    },
    {
      "payload": "apple_transactions.gems_medium_quantity_2",
      "expect": {
        "state": "rejected",
        "reason": "quantity_unsupported"
      }
    },
    {
      "payload": "apple_transactions.unknown_product",
      "expect": {
        "state": "rejected",
        "reason": "unknown_product"
      }
    },
    {
      "payload": "google_purchases.gems_medium_purchased",
      "expect": {
        "state": "verified",
        "environment": "production"
      }
    },
    {
      "payload": "google_purchases.gems_medium_pending",
      "expect": {
        "state": "pending"
      }
    },
    {
      "payload": "google_purchases.gems_medium_cancelled",
      "expect": {
        "state": "canceled"
      }
    },
    {
      "payload": "google_purchases.gems_medium_test",
      "expect": {
        "state": "verified",
        "environment": "sandbox"
      }
    },
    {
      "payload": "google_purchases.gems_medium_test",
      "config": {
        "GOOGLE_ACCEPT_TEST_PURCHASES": false
      },
      "expect": {
        "state": "rejected",
        "reason": "environment_not_accepted"
      }
    },
