{
  "description": "Expiry, activation, merge, holdings, deletion and definition-versioning cases for engagement.items, on fixtures/definitions.json. Times are UTC; the default clock is 2026-10-27T12:00:00Z. Instance ids are readable stand-ins for unique_id values.",
  "clock": "2026-10-27T12:00:00Z",
  "expiry_action_config": { "removalGraceSeconds": 86400, "deferMaxSeconds": 2592000 },
  "expiry_action_vectors": [
    { "id": "no-expiry", "expiresAt": null, "warnedAt": null, "outcome": "remove", "now": "2026-10-27T12:00:00Z", "expect": "none" },
    { "id": "before-expiry", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": null, "outcome": "remove", "now": "2026-10-29T23:59:59Z", "expect": "none" },
    { "id": "convert-at-expiry", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": null, "outcome": "convert", "now": "2026-10-30T00:00:00Z", "expect": "convert" },
    { "id": "convert-ignores-warning", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": null, "outcome": "convert", "now": "2026-11-20T00:00:00Z", "expect": "convert" },
    { "id": "remove-warned-before-expiry", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": "2026-10-28T00:00:00Z", "outcome": "remove", "now": "2026-10-30T00:00:00Z", "expect": "remove" },
    { "id": "remove-warned-before-expiry-one-second-early", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": "2026-10-28T00:00:00Z", "outcome": "remove", "now": "2026-10-29T23:59:59Z", "expect": "none" },
    { "id": "remove-never-warned-after-expiry", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": null, "outcome": "remove", "now": "2026-11-05T00:00:00Z", "expect": "unusable" },
    { "id": "remove-never-warned-last-second", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": null, "outcome": "remove", "now": "2026-11-28T23:59:59Z", "expect": "unusable" },
    { "id": "remove-never-warned-defer-max", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": null, "outcome": "remove", "now": "2026-11-29T00:00:00Z", "expect": "remove" },
    { "id": "remove-first-shown-after-expiry-before-grace", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": "2026-11-02T08:00:00Z", "outcome": "remove", "now": "2026-11-03T07:59:59Z", "expect": "unusable" },
    { "id": "remove-first-shown-after-expiry-at-grace", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": "2026-11-02T08:00:00Z", "outcome": "remove", "now": "2026-11-03T08:00:00Z", "expect": "remove" },
    { "id": "remove-shown-at-expiry-instant", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": "2026-10-30T00:00:00Z", "outcome": "remove", "now": "2026-10-30T12:00:00Z", "expect": "unusable" },
    { "id": "remove-shown-so-late-defer-max-wins", "expiresAt": "2026-10-30T00:00:00Z", "warnedAt": "2026-11-28T12:00:00Z", "outcome": "remove", "now": "2026-11-29T00:00:00Z", "expect": "remove" }
  ],
  "expiry_cases": [
    { "id": "convert-copy-expires", "account": "account-expiry-001", "config": "default", "clock": "2026-10-30T00:00:00Z",
      "given": { "instances": [{ "id": "inst-e1", "item_code": "badge_event", "state": "owned", "expires_at": "2026-10-30T00:00:00Z", "version": 1 }], "balances": { "coins": 10 } },
      "call": "run the expiry sweep",
      "expect": { "instance": { "id": "inst-e1", "state": "expired", "version": 2 }, "ledger_calls": [{ "op": "grant", "currency": "coins", "amount": 25, "reason": "items.expire", "step": "g0" }], "balances_after": { "coins": 35 }, "notice_state": "unseen", "events": ["item_expired"] } },
    { "id": "sweep-twice-converts-once", "account": "account-expiry-001", "config": "default", "clock": "2026-10-30T00:00:00Z",
      "call": "run the expiry sweep twice", "expect": { "ledger_entries_for_step_g0": 1, "balances_after": { "coins": 35 } } },
    { "id": "remove-copy-warned", "account": "account-expiry-002", "config": "default", "clock": "2026-10-30T00:00:00Z",
      "given": { "instances": [{ "id": "inst-e2", "item_code": "charm_trial", "state": "owned", "expires_at": "2026-10-30T00:00:00Z", "warned_at": "2026-10-28T09:00:00Z", "version": 1 }] },
      "call": "run the expiry sweep", "expect": { "instance": { "id": "inst-e2", "state": "expired" }, "ledger_calls": [], "capacity_freed": 0, "note": "charm_trial has no bag, so no capacity changes" } },
    { "id": "remove-copy-never-warned-stays", "account": "account-expiry-003", "config": "default", "clock": "2026-11-05T00:00:00Z",
      "given": { "instances": [{ "id": "inst-e3", "item_code": "charm_trial", "state": "owned", "expires_at": "2026-10-30T00:00:00Z", "warned_at": null, "version": 1 }] },
      "call": "run the expiry sweep", "expect": { "instance": { "id": "inst-e3", "state": "owned" }, "usable": false, "consume_equip_upgrade": "item_expired", "discard_and_convert": "still allowed" } },
    { "id": "inventory-read-sets-warned-at", "account": "account-expiry-003", "config": "default", "clock": "2026-10-28T00:00:00Z",
      "given": { "instances": [{ "id": "inst-e3", "item_code": "charm_trial", "state": "owned", "expires_at": "2026-10-30T00:00:00Z", "warned_at": null, "version": 1 }] },
      "call": "GET /api/items/inventory twice",
      "expect": { "first_read": { "inst-e3": { "expiring": true, "warned_at": "2026-10-28T00:00:00Z" } }, "second_read": { "warned_at": "unchanged" }, "events": ["item_expiring_soon"], "item_expiring_soon_count": 1 } },
    { "id": "read-outside-warning-window-does-not-warn", "account": "account-expiry-003", "config": "default", "clock": "2026-10-26T00:00:00Z",
      "call": "GET /api/items/inventory for an instance expiring at 2026-10-30T00:00:00Z",
      "expect": { "warned_at": null, "expiring": false } },
    { "id": "offline-player-returns-after-expiry", "account": "account-expiry-003", "config": "default", "clock": "2026-11-05T09:00:00Z",
      "given": { "instances": [{ "id": "inst-e3", "item_code": "charm_trial", "state": "owned", "expires_at": "2026-10-30T00:00:00Z", "warned_at": null, "version": 1 }] },
      "call": "GET /api/items/inventory, then the sweep at 2026-11-06T08:59:59Z, then the sweep at 2026-11-06T09:00:00Z",
      "expect": { "read": { "inst-e3": { "usable": false, "warned_at": "2026-11-05T09:00:00Z" } }, "sweep_one_second_early": "inst-e3 stays owned", "sweep_at_grace": "inst-e3 expired" } },
    { "id": "stack-expires-converts", "account": "account-expiry-004", "config": "default", "clock": "2026-10-30T00:00:00Z",
      "given": { "balances": { "key_frost": 12, "coins": 0 } },
      "call": "run the expiry sweep for key_frost",
      "expect": { "operation_key": "expire:account-expiry-004:key_frost:1793318400",
        "ledger_calls": [{ "op": "spend", "currency": "key_frost", "amount": 12, "reason": "items.expire", "step": "s0" }, { "op": "grant", "currency": "coins", "amount": 60, "reason": "items.expire", "step": "g0" }],
        "balances_after": { "key_frost": 0, "coins": 60 }, "notice_state": "unseen", "faucet_rows_of_key_frost_enabled": false } },
    { "id": "stack-expiry-twice-once", "account": "account-expiry-004", "config": "default", "clock": "2026-10-30T00:00:00Z",
      "call": "run the expiry sweep twice, and a stacks read between", "expect": { "operation_rows": 1, "balances_after": { "key_frost": 0, "coins": 60 } } },
    { "id": "stack-expiry-lazy-on-read", "account": "account-expiry-005", "config": "default", "clock": "2026-10-31T10:00:00Z",
      "given": { "balances": { "key_frost": 3, "coins": 0 } },
      "call": "GET /api/items/stacks before any sweep ran",
      "expect": { "stacks": [], "balances_after": { "key_frost": 0, "coins": 15 }, "notice_state": "unseen" } },
    { "id": "stack-expiry-player-consumed-meanwhile", "account": "account-expiry-004", "config": "default", "clock": "2026-10-30T00:00:00Z",
      "given": { "balances": { "key_frost": 12, "coins": 0 } },
      "fault": "the player consumes one key between the balance read and the spend, so the spend of 12 is rejected",
      "call": "run the expiry sweep",
      "expect": { "first_spend": "insufficient_balance, nothing written", "plan_rebuilt_from_balance": 11, "ledger_calls": [{ "op": "spend", "currency": "key_frost", "amount": 11, "reason": "items.expire", "step": "s0" }, { "op": "grant", "currency": "coins", "amount": 55, "reason": "items.expire", "step": "g0" }], "balances_after": { "key_frost": 0, "coins": 55 } } },
    { "id": "stack-expiry-crash-between-spend-and-grant", "account": "account-expiry-004", "config": "default", "clock": "2026-10-30T00:00:00Z",
      "given": { "balances": { "key_frost": 12, "coins": 0 } },
      "fault": "process stops after the spend applied and before the grant",
      "call": "run recovery", "expect": { "balances_after": { "key_frost": 0, "coins": 60 }, "ledger_entries": { "s0": 1, "g0": 1 } } },
    { "id": "expired-stack-not-removed-without-value", "account": "account-expiry-004", "config": "default",
      "call": "publish a count definition with absolute expiry and outcome remove",
      "expect": { "error": "count_expiry_must_convert" } }
  ],
  "activation_vectors": [
    { "id": "none-active", "policy": "extend", "activation_seconds": 1800, "now": "2026-10-27T12:00:00Z", "active_ends_at": [], "max_remaining_seconds": 2592000, "expect": { "starts_at": "2026-10-27T12:00:00Z", "ends_at": "2026-10-27T12:30:00Z" } },
    { "id": "extend-after-active", "policy": "extend", "activation_seconds": 1800, "now": "2026-10-27T12:00:00Z", "active_ends_at": ["2026-10-27T12:10:00Z"], "max_remaining_seconds": 2592000, "expect": { "starts_at": "2026-10-27T12:10:00Z", "ends_at": "2026-10-27T12:40:00Z" } },
    { "id": "extend-uses-latest-of-several", "policy": "extend", "activation_seconds": 1800, "now": "2026-10-27T12:00:00Z", "active_ends_at": ["2026-10-27T12:10:00Z", "2026-10-27T12:50:00Z"], "max_remaining_seconds": 2592000, "expect": { "starts_at": "2026-10-27T12:50:00Z", "ends_at": "2026-10-27T13:20:00Z" } },
    { "id": "extend-past-limit", "policy": "extend", "activation_seconds": 1800, "now": "2026-10-27T12:00:00Z", "active_ends_at": ["2026-10-27T12:50:00Z"], "max_remaining_seconds": 3600, "expect": { "error": "activation_limit" } },
    { "id": "extend-exactly-at-limit", "policy": "extend", "activation_seconds": 1800, "now": "2026-10-27T12:00:00Z", "active_ends_at": ["2026-10-27T12:30:00Z"], "max_remaining_seconds": 3600, "expect": { "starts_at": "2026-10-27T12:30:00Z", "ends_at": "2026-10-27T13:00:00Z" } },
    { "id": "refuse-while-active", "policy": "refuse", "activation_seconds": 1800, "now": "2026-10-27T12:00:00Z", "active_ends_at": ["2026-10-27T12:10:00Z"], "max_remaining_seconds": 2592000, "expect": { "error": "activation_refused" } },
    { "id": "refuse-after-end", "policy": "refuse", "activation_seconds": 1800, "now": "2026-10-27T12:10:00Z", "active_ends_at": ["2026-10-27T12:10:00Z"], "max_remaining_seconds": 2592000, "expect": { "starts_at": "2026-10-27T12:10:00Z", "ends_at": "2026-10-27T12:40:00Z" }, "note": "a row whose ends_at equals now is not active" },
    { "id": "client-clock-a-day-ahead", "policy": "extend", "activation_seconds": 1800, "now": "2026-10-27T12:00:00Z", "device_time": "2026-10-28T12:00:00Z", "active_ends_at": [], "max_remaining_seconds": 2592000, "expect": { "starts_at": "2026-10-27T12:00:00Z", "ends_at": "2026-10-27T12:30:00Z" } }
  ],
  "merge_cases": {
    "guest": {
      "account": "account-guest-001",
      "instances": [
        { "id": "g-hero-ember", "item_code": "hero_ember", "level": 3, "version": 3, "state": "owned", "granted_at": "2026-10-20T10:00:00Z", "source_kind": "random" },
        { "id": "g-sword-1", "item_code": "sword_iron", "level": 2, "version": 2, "state": "owned", "granted_at": "2026-10-21T10:00:00Z", "source_kind": "fixed" },
        { "id": "g-sword-2", "item_code": "sword_iron", "level": 1, "version": 1, "state": "owned", "granted_at": "2026-10-22T10:00:00Z", "source_kind": "fixed" },
        { "id": "g-frame", "item_code": "frame_gold", "level": 1, "version": 1, "state": "owned", "granted_at": "2026-10-23T10:00:00Z", "source_kind": "purchase" },
        { "id": "g-charm", "item_code": "charm_trial", "level": 1, "version": 1, "state": "owned", "granted_at": "2026-10-26T10:00:00Z", "expires_at": "2026-11-02T10:00:00Z", "source_kind": "fixed" }
      ],
      "equips": [{ "target_key": "g-hero-ember", "slot": "weapon", "instance_id": "g-sword-1" }],
      "held_grants": [{ "grant_id": "grant-g1", "item_code": "sword_iron", "held_quantity": 1, "hold_reason": "bag_full" }],
      "activations": [{ "item_code": "booster_double_xp", "starts_at": "2026-10-27T11:40:00Z", "ends_at": "2026-10-27T12:10:00Z" }]
    },
    "target": {
      "account": "account-target-001",
      "instances": [
        { "id": "t-hero-ember", "item_code": "hero_ember", "level": 1, "version": 1, "state": "owned", "granted_at": "2026-10-10T10:00:00Z", "source_kind": "random" },
        { "id": "t-sword-1", "item_code": "sword_iron", "level": 1, "version": 1, "state": "owned", "granted_at": "2026-10-11T10:00:00Z", "source_kind": "fixed" }
      ],
      "equips": [], "held_grants": [],
      "activations": [{ "item_code": "booster_double_xp", "starts_at": "2026-10-27T11:50:00Z", "ends_at": "2026-10-27T12:20:00Z" }]
    },
    "merge_id": "link:att-001",
    "cases": [
      { "id": "merge-moves-and-converts", "config": "default",
        "call": "mergeAccounts(account-guest-001, account-target-001, link:att-001)",
        "expect": {
          "g-hero-ember": { "state": "converted", "reason": "target owns max_copies 1 of hero_ember; the existing copy t-hero-ember stays at level 1" },
          "ledger_calls": [{ "op": "grant", "account": "account-target-001", "currency": "shards_ember", "amount": 30, "reason": "items.duplicate", "step": "g0" }],
          "moved": ["g-sword-1", "g-sword-2", "g-frame", "g-charm"],
          "moved_rows": { "account_id": "account-target-001", "added_at": "2026-10-27T12:00:00Z", "version_increment": 1 },
          "equips": { "g-sword-1_on_g-hero-ember": "removed because the target unit did not move", "g-sword-1_state": "owned" },
          "held_moved": ["grant-g1"],
          "activations": [{ "account": "account-target-001", "item_code": "booster_double_xp", "starts_at": "2026-10-27T12:20:00Z", "ends_at": "2026-10-27T12:30:00Z" }],
          "guest_account_row": { "merged_into_account_id": "account-target-001" },
          "result": { "moved_instances": 4, "converted_duplicates": 1, "moved_held": 1, "moved_activation_seconds": 600 },
          "events": ["item_duplicate_converted", "items_merged"],
          "instance_count_conserved": "5 guest instances = 4 moved + 1 converted; the target gains none other"
        } },
      { "id": "merge-replay-same-merge-id", "config": "default",
        "call": "mergeAccounts again with link:att-001",
        "expect": { "result": "equal to the first", "ledger_entries_for_step_g0": 1, "instances_moved_total": 4, "activation_rows_on_target": 2 } },
      { "id": "merge-second-merge-id-fails", "config": "default",
        "call": "mergeAccounts(account-guest-001, account-target-001, link:att-002) after the first merge",
        "expect": { "error": "already_merged", "changes": "none" } },
      { "id": "merge-into-another-account-fails", "config": "default",
        "call": "mergeAccounts(account-guest-001, account-other-009, link:att-003) after the first merge",
        "expect": { "error": "already_merged", "changes": "none" } },
      { "id": "merge-waits-for-guest-operation", "config": "default",
        "given": "the guest has an upgrade operation in state debited",
        "call": "mergeAccounts(account-guest-001, account-target-001, link:att-001)",
        "expect": { "first_answer": "merge_incomplete", "changes": "none", "after_recovery_and_retry_with_same_merge_id": "the result of merge-moves-and-converts" } },
      { "id": "merge-surplus-convert-rule", "config": "default",
        "given": "guest holds hero_cinder level 1 and the target holds hero_cinder level 2",
        "call": "mergeAccounts",
        "expect": { "guest_copy_state": "converted", "ledger_calls": [{ "op": "grant", "account": "account-target-001", "currency": "coins", "amount": 150, "reason": "items.duplicate" }], "target_copy": "unchanged" } },
      { "id": "merge-cap-rule-moves-both", "config": "default",
        "given": "guest and target both hold frame_gold",
        "call": "mergeAccounts",
        "expect": { "guest_copy": "moved", "copies_on_target": 2, "later_fixed_grant_of_frame_gold": "at_cap" } },
      { "id": "merge-ignores-capacity", "config": "small_bags",
        "given": "the target's equipment bag is full (3 of 3) and the guest holds two sword_iron",
        "call": "mergeAccounts",
        "expect": { "moved": 2, "equipment_used_on_target": 5, "later_fixed_grant_of_sword_iron": "held with hold_reason bag_full" } },
      { "id": "merge-guest-holds-nothing", "config": "default",
        "given": "the guest has no instances, held grants or activations",
        "call": "mergeAccounts", "expect": { "result": { "moved_instances": 0, "converted_duplicates": 0, "moved_held": 0, "moved_activation_seconds": 0 }, "guest_account_row": { "merged_into_account_id": "set" } } },
      { "id": "merge-after-merge-resolves-pointer", "config": "default",
        "call": "items.grant for account-guest-001 after the merge",
        "expect": { "grant_lands_on": "account-target-001" } }
    ]
  },
  "holdings_cases": [
    { "id": "holdings-all-three", "account": "account-guest-001",
      "expect": [
        { "category": "items", "label_key": "items.holdings.instances", "paid": true, "effect": "carried" },
        { "category": "items", "label_key": "items.holdings.held", "paid": false, "effect": "carried" },
        { "category": "items", "label_key": "items.holdings.boosters", "paid": false, "effect": "carried" }
      ] },
    { "id": "holdings-instances-without-purchase", "account": "account-001-without-purchases",
      "given": "owned instances with source_kind fixed and random only", "expect": [{ "category": "items", "label_key": "items.holdings.instances", "paid": false, "effect": "carried" }] },
    { "id": "holdings-empty", "account": "account-new", "expect": [] },
    { "id": "holdings-ignores-terminal-and-ended", "account": "account-001",
      "given": "only discarded instances, no held grants, and an activation that ended", "expect": [] },
    { "id": "holdings-writes-nothing", "account": "account-guest-001", "call": "holdings twice", "expect": { "inventory_version": "unchanged" } }
  ],
  "deletion_cases": [
    { "id": "delete-removes-everything", "account": "account-001", "config": "default",
      "given": "an upgrade operation in state debited and a held grant",
      "call": "deleteAccount(account-001)",
      "expect": { "rows_remaining": { "item_instances": 0, "item_equips": 0, "item_grants": 0, "item_activations": 0, "item_operations": 0, "item_accounts": 0 }, "ledger_rows": "not touched by this block" } },
    { "id": "delete-twice", "account": "account-001", "config": "default",
      "call": "deleteAccount(account-001) twice", "expect": { "second_call": "success, nothing to delete" } },
    { "id": "delete-resumes-after-partial-run", "account": "account-001", "config": "default",
      "fault": "the first run stops after the equips and activations were deleted",
      "call": "deleteAccount again", "expect": { "rows_remaining_total": 0 } },
    { "id": "delete-unknown-account", "account": "account-never-seen", "call": "deleteAccount", "expect": { "result": "success" } }
  ],
  "definition_versioning_cases": [
    { "id": "publish-new-version-supersedes", "config": "default",
      "call": "publish sword_iron version 2 with display_name_key item.sword_iron.name_v2 and the level 3 cost at 250 coins",
      "expect": { "v1_status": "superseded", "v2_status": "active", "instances_keep_definition_version": 1, "new_grants_use_version": 2, "quote_for_level_3_uses_version": 2 } },
    { "id": "publish-is-idempotent", "config": "default",
      "call": "publish the same draft twice", "expect": { "definitions_rows": 1, "currency_flows_rows_registered_once": true } },
    { "id": "publish-registers-flows", "config": "default",
      "call": "publish every active definition of fixtures/definitions.json", "expect": { "currency_flows_rows": "equal to expected_flows in fixtures/definitions.json", "currencies_rows_for_instance_codes": 0 } },
    { "id": "retire-stops-grants-only", "config": "default",
      "call": "retire sword_iron, then grant, equip, upgrade, convert and discard an existing copy",
      "expect": { "grant": "item_retired", "equip": "allowed", "upgrade": "allowed", "convert": "allowed", "discard": "allowed", "definition_read": "returns the retired definition with its display keys" } },
    { "id": "retired-item-stays-in-inventory", "account": "account-retired", "config": "default",
      "call": "GET /api/items/inventory", "expect": { "items_include": "inst-r1", "definition_status": "retired", "label": "not available to get" } },
    { "id": "delete-referenced-definition-refused", "config": "default",
