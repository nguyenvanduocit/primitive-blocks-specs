  ],
  "upgrade_cases": [
    { "id": "upgrade-happy", "account": "account-001", "config": "default", "instance": "inst-002",
      "call": { "request_id": "req-0001", "expected_version": 3, "expected_cost": [{ "currency": "coins", "amount": 200 }] },
      "expect": { "operation_state": "applied", "instance": { "level": 3, "version": 4 },
        "ledger_calls": [{ "op": "spend", "currency": "coins", "amount": 200, "reason": "items.upgrade", "step": "s0" }],
        "balances_after": { "coins": 140 }, "events": ["item_upgraded"] } },
    { "id": "upgrade-replay", "account": "account-001", "config": "default", "instance": "inst-002",
      "call": "upgrade-happy twice with request_id req-0001",
      "expect": { "second_result": "the stored result of the first", "ledger_calls_total": 1, "instance": { "level": 3, "version": 4 } } },
    { "id": "upgrade-request-id-different-body", "account": "account-001", "config": "default", "instance": "inst-002",
      "call": "upgrade-happy, then request_id req-0001 again with expected_version 4",
