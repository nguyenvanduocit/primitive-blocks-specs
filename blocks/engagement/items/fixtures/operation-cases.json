      "call": { "request_id": "req-0002", "expected_version": 3, "expected_cost": [{ "currency": "coins", "amount": 100 }] },
      "expect": { "error": "cost_changed", "new_quote": [{ "currency": "coins", "amount": 200 }], "ledger_calls": [], "instance": { "level": 2, "version": 3 } } },
    { "id": "upgrade-cost-changed-by-publish", "account": "account-001", "config": "default", "instance": "inst-002",
      "call": "quote at version 1 of sword_iron, publish version 2 with the level 3 cost at coins 250, then confirm the old quote",
      "expect": { "error": "cost_changed", "new_quote": [{ "currency": "coins", "amount": 250 }], "ledger_calls": [] } },
