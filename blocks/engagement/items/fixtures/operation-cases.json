  "upgrade_fault_cases": [
    { "id": "crash-after-first-spend", "base": "upgrade-two-lines-applied",
      "fault": "process stops after the coins spend (step s0) applied",
      "expect": { "state_at_stop": "pending", "after_recovery": { "operation_state": "applied", "instance": { "level": 3 }, "ledger_entries": { "s0": 1, "s1": 1 } }, "balances_after": { "coins": 400, "shards_ember": 20 } } },
    { "id": "crash-after-all-spends", "base": "upgrade-happy",
      "fault": "process stops after the spend applied and the operation is debited, before the compare-and-swap",
      "expect": { "state_at_stop": "debited", "after_recovery": { "operation_state": "applied", "instance": { "level": 3, "version": 4 }, "ledger_entries": { "s0": 1 } }, "refunds": 0 } },
    { "id": "crash-after-apply-before-mark", "base": "upgrade-happy",
      "fault": "process stops after the compare-and-swap committed, before the operation is marked applied",
      "expect": { "instance": { "level": 3, "version": 4, "last_operation_id": "the operation id" }, "after_recovery": { "operation_state": "applied", "refunds": 0, "ledger_entries": { "s0": 1 } } } },
    { "id": "version-bumped-after-spend", "base": "upgrade-happy",
      "fault": "another change bumps the instance version (a revoke, an expiry or a merge) after the spend applied",
      "expect": { "after_recovery": { "operation_state": "reverted", "instance_level_unchanged": true, "ledger_calls": [{ "op": "grant", "currency": "coins", "amount": 200, "reason": "items.upgrade-refund", "step": "r0" }], "balances_after": { "coins": 340 } }, "error_to_caller": "version_conflict" } },
    { "id": "ledger-unavailable-before-spend", "base": "upgrade-happy",
      "fault": "the ledger spend fails with a transient error",
      "expect": { "first_answer": "ledger_unavailable", "operation_state": "pending", "retry_with_same_request_id": { "operation_state": "applied", "ledger_entries": { "s0": 1 } } } },
    { "id": "recovery-runs-twice", "base": "crash-after-all-spends",
      "fault": "the recovery job runs twice on the same operation",
      "expect": { "ledger_entries": { "s0": 1 }, "instance": { "level": 3, "version": 4 } } }
  ],
  "consume_cases": [
