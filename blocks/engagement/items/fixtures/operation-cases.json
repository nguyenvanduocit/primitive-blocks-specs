    { "id": "upgrade-retired-blocked", "account": "account-retired", "config": "retired_no_upgrade", "instance": "inst-r1",
      "call": { "request_id": "req-0013", "expected_version": 1, "expected_cost": [{ "currency": "coins", "amount": 50 }] },
      "expect": { "error": "item_retired", "ledger_calls": [] } },
    { "id": "upgrade-client-sends-level", "account": "account-001", "config": "default", "instance": "inst-002",
