    ],
    "trusted_late_progress": {
      "PROGRESS_GRACE_SECONDS": 300,
      "event": "evt-weekly-sprint-w44",
      "cases": [
        { "caller": "server", "occurred_at": "2026-11-01T23:59:58Z", "now": "2026-11-02T00:03:00Z", "result": "accepted" },
        { "caller": "server", "occurred_at": "2026-11-02T00:00:00Z", "now": "2026-11-02T00:03:00Z", "result": "409 event_ended" },
        { "caller": "server", "occurred_at": "2026-11-01T23:59:58Z", "now": "2026-11-02T00:05:00Z", "result": "409 event_ended" },
        { "caller": "client", "occurred_at": "2026-11-01T23:59:58Z", "now": "2026-11-02T00:03:00Z", "result": "409 event_ended", "note": "a client-reported write is judged by receipt time and has no grace" }
      ],
      "settlement_not_before": "2026-11-02T00:05:00Z"
    }
  },
  "client_clock_cases": {
    "rule": "remaining = ends_at - (server_now + (monotonic_now - monotonic_at_receipt)); the device wall clock is read once, never used for remaining time",
    "received": { "server_now": "2026-10-27T12:00:00.000Z", "device_wall_at_receipt": "2026-10-27T12:05:00.000Z", "monotonic_at_receipt_ms": 1000000, "ends_at": "2026-10-27T17:00:00Z" },
    "checks": [
      { "monotonic_now_ms": 1000000, "device_wall_now": "2026-10-27T12:05:00.000Z", "remaining_ms": 18000000, "note": "device clock 5 minutes fast, remaining is still 5 hours" },
      { "monotonic_now_ms": 1600000, "device_wall_now": "2026-10-27T12:15:00.000Z", "remaining_ms": 17400000 },
      { "monotonic_now_ms": 1600000, "device_wall_now": "2026-10-28T09:00:00.000Z", "remaining_ms": 17400000, "note": "the player moved the device clock forward; remaining time does not change" },
      { "monotonic_now_ms": 19000000, "device_wall_now": "2026-10-27T17:05:00.000Z", "remaining_ms": 0, "ui": "checking, then the server's answer decides" }
    ],
    "after_restart": { "monotonic_source_lost": true, "countdown": "not shown as ticking", "ui": "absolute end time with the label approximate until the next discovery response" },
    "boundary_refetch": { "BOUNDARY_JITTER_MAX_SECONDS": 5, "refetch_at": "boundary + uniform random in [0, 5] seconds" }
  }
