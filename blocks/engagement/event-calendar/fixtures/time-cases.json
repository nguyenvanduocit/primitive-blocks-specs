      { "zone": "America/New_York", "local": "2026-03-08T02:30:00", "utc": "2026-03-08T07:30:00Z", "case": "does not occur" },
      { "zone": "America/New_York", "local": "2026-11-01T01:30:00", "utc": "2026-11-01T05:30:00Z", "case": "occurs twice, first occurrence" }
    ],
    "day_lengths": [
      { "zone": "America/New_York", "local_day": "2026-03-08", "starts_at": "2026-03-08T05:00:00Z", "ends_at": "2026-03-09T04:00:00Z", "seconds": 82800 },
      { "zone": "America/New_York", "local_day": "2026-11-01", "starts_at": "2026-11-01T04:00:00Z", "ends_at": "2026-11-02T05:00:00Z", "seconds": 90000 },
      { "zone": "Europe/Berlin", "local_day": "2026-10-25", "starts_at": "2026-10-24T22:00:00Z", "ends_at": "2026-10-25T23:00:00Z", "seconds": 90000 }
    ],
    "outer_bounds": [
      { "local_starts_at": "2026-10-27T00:00:00", "local_ends_at": "2026-10-28T00:00:00", "starts_at": "2026-10-26T10:00:00Z", "ends_at": "2026-10-28T12:00:00Z", "rule": "starts_at = local start read as UTC minus 14 hours; ends_at = local end read as UTC plus 12 hours" }
    ]
  },
  "version_cases": {
    "rule": "One to three dot-separated non-negative integers compared numerically per component; a missing component is 0. Any other string is malformed and compares as 0.0.0. A null min_app_version means no requirement.",
    "cases": [
      { "client": "2.5.0", "min": "2.4.0", "supported": true },
      { "client": "2.4.0", "min": "2.4.0", "supported": true },
      { "client": "2.3.5", "min": "2.4.0", "supported": false },
      { "client": "2.10.0", "min": "2.9.0", "supported": true },
      { "client": "2.9.0", "min": "2.10.0", "supported": false },
      { "client": "2.4", "min": "2.4.0", "supported": true },
      { "client": "2.4.0-beta", "min": "2.4.0", "supported": false },
      { "client": "", "min": "2.4.0", "supported": false },
      { "client": "", "min": null, "supported": true },
      { "client": "2.0.0", "min": null, "supported": true }
    ]
  },
  "write_boundary_cases": {
    "rule": "join and progress need state live or ending-soon at the server instant read inside the write transaction",
