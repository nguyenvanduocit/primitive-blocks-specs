{
  "note": "Pure-function cases: state derivation, local window resolution, version comparison, write boundaries and client clock correction. Event ids refer to fixtures/events.json; config values are the ones in its config block.",
  "state_rule": {
    "ending_soon_window": "min(ENDING_SOON_WINDOW_SECONDS[layer], floor((authored ends_at - starts_at) / 4))",
    "effective_end": "min(ends_at, closes_at) where closes_at may be null",
    "ending_soon_at": "max(starts_at, effective_end - ending_soon_window)",
    "archive_at": "effective_end + CLAIM_GRACE_SECONDS[layer]",
    "intervals": "scheduled [-inf, starts_at), live [starts_at, ending_soon_at), ending-soon [ending_soon_at, effective_end), ended [effective_end, archive_at), archived [archive_at, +inf)"
  },
  "state_cases": [
    { "name": "weekly absolute", "event": "evt-weekly-sprint-w44", "derived": { "ending_soon_at": "2026-11-01T00:00:00Z", "effective_end": "2026-11-02T00:00:00Z", "archive_at": "2026-11-05T00:00:00Z" },
      "checks": [
        { "at": "2026-10-25T23:59:59.999Z", "state": "scheduled" },
        { "at": "2026-10-26T00:00:00.000Z", "state": "live" },
        { "at": "2026-10-31T23:59:59.999Z", "state": "live" },
        { "at": "2026-11-01T00:00:00.000Z", "state": "ending-soon" },
        { "at": "2026-11-01T23:59:59.999Z", "state": "ending-soon" },
        { "at": "2026-11-02T00:00:00.000Z", "state": "ended" },
        { "at": "2026-11-04T23:59:59.999Z", "state": "ended" },
        { "at": "2026-11-05T00:00:00.000Z", "state": "archived" }
      ] },
    { "name": "seasonal absolute", "event": "evt-harvest-season", "derived": { "ending_soon_at": "2026-11-06T00:00:00Z", "effective_end": "2026-11-09T00:00:00Z", "archive_at": "2026-11-16T00:00:00Z" },
      "checks": [
        { "at": "2026-11-05T23:59:59.999Z", "state": "live" },
        { "at": "2026-11-06T00:00:00.000Z", "state": "ending-soon" },
        { "at": "2026-11-09T00:00:00.000Z", "state": "ended" },
        { "at": "2026-11-16T00:00:00.000Z", "state": "archived" }
      ] },
    { "name": "daily local window of acc-ann (UTC+7)", "event": "evt-daily-1027", "account_id": "acc-ann", "resolved_window": { "starts_at": "2026-10-26T17:00:00Z", "ends_at": "2026-10-27T17:00:00Z" }, "derived": { "ending_soon_at": "2026-10-27T16:00:00Z", "effective_end": "2026-10-27T17:00:00Z", "archive_at": "2026-10-28T17:00:00Z" },
      "checks": [
        { "at": "2026-10-27T15:59:59.999Z", "state": "live" },
        { "at": "2026-10-27T16:00:00.000Z", "state": "ending-soon" },
        { "at": "2026-10-27T17:00:00.000Z", "state": "ended" },
        { "at": "2026-10-28T16:59:59.999Z", "state": "ended" },
        { "at": "2026-10-28T17:00:00.000Z", "state": "archived" }
      ] },
    { "name": "short QA event clamps the ending-soon window", "event": "evt-qa-short", "derived": { "ending_soon_window_seconds": 1800, "ending_soon_at": "2026-10-27T12:30:00Z", "effective_end": "2026-10-27T13:00:00Z", "archive_at": "2026-10-30T13:00:00Z" },
      "checks": [
        { "at": "2026-10-27T12:29:59.999Z", "state": "live" },
        { "at": "2026-10-27T12:30:00.000Z", "state": "ending-soon" },
        { "at": "2026-10-27T13:00:00.000Z", "state": "ended" }
      ] },
    { "name": "extension moves the ending-soon instant later", "event": "evt-weekly-sprint-w44", "operation": { "kind": "extend", "new_ends_at": "2026-11-03T00:00:00Z" }, "derived": { "ending_soon_at": "2026-11-02T00:00:00Z", "effective_end": "2026-11-03T00:00:00Z", "archive_at": "2026-11-06T00:00:00Z" },
      "checks": [
        { "at": "2026-11-01T12:00:00.000Z", "state": "live", "note": "ending-soon before the extension" },
        { "at": "2026-11-02T00:00:00.000Z", "state": "ending-soon" },
        { "at": "2026-11-03T00:00:00.000Z", "state": "ended" }
      ] },
    { "name": "emergency end with notice", "event": "evt-weekly-sprint-w44", "operation": { "kind": "end_now", "closes_at": "2026-10-28T12:00:00Z" }, "derived": { "ending_soon_at": "2026-10-27T12:00:00Z", "effective_end": "2026-10-28T12:00:00Z", "archive_at": "2026-10-31T12:00:00Z" },
      "checks": [
        { "at": "2026-10-27T11:59:59.999Z", "state": "live" },
        { "at": "2026-10-27T12:00:00.000Z", "state": "ending-soon" },
        { "at": "2026-10-28T12:00:00.000Z", "state": "ended" },
        { "at": "2026-10-31T12:00:00.000Z", "state": "archived" }
      ] },
    { "name": "emergency end now skips ending-soon", "event": "evt-weekly-sprint-w44", "operation": { "kind": "end_now", "closes_at": "2026-10-27T12:00:00Z", "performed_at": "2026-10-27T12:00:00Z" }, "note": "states are evaluated at or after the instant the operation is performed",
      "checks": [
        { "at": "2026-10-27T12:00:00.000Z", "state": "ended" },
        { "at": "2026-10-27T12:00:00.001Z", "state": "ended" }
      ] }
  ],
  "window_cases": {
    "rule": "A local wall-clock time resolves in the account's IANA timezone. A time that does not occur (clocks move forward) uses the UTC offset before the gap; a time that occurs twice (clocks move back) is the first occurrence (RFC 5545 section 3.3.5, FORM #3).",
    "resolve": [
      { "zone": "Asia/Ho_Chi_Minh", "local": "2026-10-28T00:00:00", "utc": "2026-10-27T17:00:00Z" },
      { "zone": "Asia/Kolkata", "local": "2026-10-28T00:00:00", "utc": "2026-10-27T18:30:00Z" },
      { "zone": "America/New_York", "local": "2026-10-28T00:00:00", "utc": "2026-10-28T04:00:00Z" },
