            "item": { "id": "item-0003", "state": "running", "starts_at": "2026-10-21T13:00:00Z", "ends_at": "2026-10-21T13:15:00Z" },
            "note": "ready items do not hold the lane: both lane slots are free, so the new item starts at once"
          }
        }
      ]
    },
