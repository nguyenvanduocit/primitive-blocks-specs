            "stored": { "item-0001": "running", "item-0002": "queued" },
            "writes": 0,
            "note": "no job ran at 12:15:00; the read derives the states and writes nothing"
          }
        },
        {
          "at": "2026-10-21T13:00:00Z",
          "do": { "op": "start", "queue_id": "craft", "job_id": "craft.bread", "attempt_id": "att-004" },
          "expect": {
