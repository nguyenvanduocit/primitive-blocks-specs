    {
      "name": "retired-job-finishes-and-cannot-start",
      "given": { "items": [{ "id": "item-0001", "queue_id": "craft", "job_id": "craft.old-recipe", "state": "running", "ends_at": "2026-10-21T12:10:00Z" }] },
      "steps": [
        { "at": "2026-10-21T12:00:00Z", "do": { "op": "start", "queue_id": "craft", "job_id": "craft.old-recipe", "attempt_id": "att-070" }, "expect": { "error": "job_retired", "ledger": [] } },
        { "at": "2026-10-21T12:11:00Z", "do": { "op": "collect", "item_id": "item-0001" }, "expect": { "item": { "state": "collected" }, "balances": { "bread": 1 } } }
      ]
    },
    {
      "name": "config-lengthen-leaves-running-items-alone",
      "after": "start-craft-bread",
      "steps": [
        { "at": "2026-10-21T12:05:00Z", "do": { "op": "publish", "changes": { "craft.bread": { "duration_seconds": 1800 } }, "definition_version": 2 }, "expect": { "published": true, "items_changed": 0 } },
        { "at": "2026-10-21T12:14:59Z", "do": { "op": "list", "queue_id": "craft" }, "expect": { "effective": { "item-0001": "running" }, "items": { "item-0001": { "ends_at": "2026-10-21T12:15:00Z", "duration_seconds": 900, "definition_version": 1 } } } },
        { "at": "2026-10-21T12:16:00Z", "do": { "op": "start", "queue_id": "craft", "job_id": "craft.bread", "attempt_id": "att-080" }, "expect": { "item": { "id": "item-0002", "definition_version": 2, "duration_seconds": 1800, "starts_at": "2026-10-21T12:16:00Z", "ends_at": "2026-10-21T12:46:00Z" } } }
      ]
    },
    {
      "name": "operator-rebase-shortens-only",
      "after": "chain-and-lane-depth",
      "steps": [
        { "at": "2026-10-21T12:05:00Z", "do": { "op": "publish", "changes": { "craft.bread": { "duration_seconds": 600 } }, "definition_version": 2 }, "expect": { "items_changed": 0 } },
        {
          "at": "2026-10-21T12:05:10Z",
          "do": { "op": "rebase_shorter", "job_id": "craft.bread", "definition_version": 2, "reason": "event: faster crafting for running items" },
          "expect": {
            "items": {
              "item-0001": { "ends_at": "2026-10-21T12:10:00Z", "schedule_version": 2, "notice_revision": 2 },
              "item-0002": { "starts_at": "2026-10-21T12:10:00Z", "ends_at": "2026-10-21T12:20:00Z", "schedule_version": 2, "notice_revision": 2, "duration_seconds": 600 }
            },
            "handoff": [
              { "subject_key": "queue-item:item-0001", "state": "armed", "fire_at": "2026-10-21T12:10:00Z", "revision": 2 },
              { "subject_key": "queue-item:item-0002", "state": "armed", "fire_at": "2026-10-21T12:20:00Z", "revision": 2 }
            ],
            "note": "rebase lowers the snapshot duration of every queued and running item of the job to the new value and never raises it; item-0002 then starts when item-0001 now ends"
          }
        },
        { "at": "2026-10-21T12:06:00Z", "do": { "op": "rebase_shorter", "job_id": "craft.bread", "definition_version": 2 }, "expect": { "items_changed": 0, "note": "idempotent" } },
        { "at": "2026-10-21T12:07:00Z", "do": { "op": "publish", "changes": { "craft.bread": { "duration_seconds": 1200 } }, "definition_version": 3 }, "expect": { "items_changed": 0 } },
        { "at": "2026-10-21T12:07:10Z", "do": { "op": "rebase_shorter", "job_id": "craft.bread", "definition_version": 3 }, "expect": { "items_changed": 0, "note": "min(ends_at, starts_at + 1200) never lengthens" } }
      ]
    },
    {
      "name": "snapshot-keeps-refund-input-and-output",
      "after": "start-craft-bread",
      "steps": [
        { "at": "2026-10-21T12:02:00Z", "do": { "op": "publish", "changes": { "craft.bread": { "input": [{ "currency": "flour", "amount": 6 }], "output": [{ "kind": "item", "code": "bread", "amount": 3 }], "cancel_refund_fraction": 1.0 } }, "definition_version": 2 }, "expect": { "items_changed": 0 } },
        { "at": "2026-10-21T12:03:00Z", "do": { "op": "cancel", "item_id": "item-0001" }, "expect": { "refund_lines": [{ "currency": "flour", "amount": 1 }], "note": "floor(3 * 0.5) from the item's snapshot, not floor(6 * 1.0) from the new definition" } }
      ]
    },
    {
      "name": "snapshot-keeps-output",
      "after": "start-craft-bread",
      "steps": [
        { "at": "2026-10-21T12:02:00Z", "do": { "op": "publish", "changes": { "craft.bread": { "output": [{ "kind": "item", "code": "bread", "amount": 3 }] } }, "definition_version": 2 }, "expect": { "items_changed": 0 } },
        { "at": "2026-10-21T12:20:00Z", "do": { "op": "collect", "item_id": "item-0001" }, "expect": { "ledger": [{ "op": "grant", "currency": "bread", "amount": 2, "key": "timed-queues:acct-001:item-0001:collect:1" }] } }
      ]
    },
    {
      "name": "invalid-set-leaves-the-previous-set-active",
      "steps": [
        { "at": "2026-10-21T12:00:00Z", "do": { "op": "publish", "changes": { "craft.jam": { "input": [{ "currency": "coins", "amount": 40 }, { "currency": "gems", "amount": 1 }] } }, "definition_version": 2 }, "expect": { "published": false, "error": "premium_input", "active_definition_version": 1 } }
      ]
    },
    {
      "name": "merge-keeps-the-busier-lane",
      "given": { "note": "guest account guest-9 and account acct-001 both have craft slot 0 busy" },
      "steps": [
        {
          "at": "2026-10-21T12:00:00Z",
          "do": { "op": "mergeAccounts", "from": "guest-9", "into": "acct-001", "merge_id": "merge-1", "from_items": [{ "id": "g-1", "queue_id": "craft", "slot_index": 0, "state": "running", "ends_at": "2026-10-21T12:10:00Z", "input_snapshot": [{ "currency": "flour", "amount": 3 }] }, { "id": "g-r", "queue_id": "craft", "slot_index": 0, "state": "ready" }], "into_items": [{ "id": "a-1", "queue_id": "craft", "slot_index": 0, "state": "running", "ends_at": "2026-10-21T13:00:00Z" }] },
          "expect": {
            "kept": ["a-1", "g-r"],
            "cancelled": [{ "id": "g-1", "cancel_reason": "operator", "refund_fraction": 1, "refund_lines": [{ "currency": "flour", "amount": 3 }] }],
            "rule": "the lane with the larger remaining time keeps its items; ready items of both accounts are kept; the other lane's queued and running items are cancelled with a full refund"
          }
        },
        { "at": "2026-10-21T12:00:00Z", "do": { "op": "mergeAccounts", "from": "guest-9", "into": "acct-001", "merge_id": "merge-1", "repeat": true }, "expect": { "result": "the first result of merge-1 is returned", "changes": 0 } },
        { "at": "2026-10-21T12:00:01Z", "do": { "op": "mergeAccounts", "from": "guest-9", "into": "acct-001", "merge_id": "merge-2", "from_items": [{ "id": "g-2", "queue_id": "craft", "slot_index": 0, "state": "queued", "input_status": "pending" }] }, "expect": { "error": "merge_blocked_pending", "changes": 0 } }
      ]
    }
  ]
}
