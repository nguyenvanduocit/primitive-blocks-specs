          "at": "2026-10-21T12:05:00Z",
          "do": { "op": "start", "queue_id": "craft", "job_id": "craft.bread", "attempt_id": "att-002" },
          "expect": {
            "item": { "id": "item-0002", "state": "queued", "slot_index": 0, "starts_at": "2026-10-21T12:15:00Z", "ends_at": "2026-10-21T12:30:00Z", "schedule_version": 1 },
            "ledger": [{ "op": "spend", "currency": "flour", "amount": 3, "reason": "timed-queues.start", "key": "timed-queues:acct-001:item-0002:start:1" }],
            "balances": { "flour": 3 },
            "handoff": [{ "subject_key": "queue-item:item-0002", "state": "armed", "fire_at": "2026-10-21T12:30:00Z", "revision": 1 }]
          }
        },
        {
          "at": "2026-10-21T12:06:00Z",
          "do": { "op": "start", "queue_id": "craft", "job_id": "craft.bread", "attempt_id": "att-003" },
          "expect": { "error": "lane_full", "ledger": [], "balances": { "flour": 3 }, "note": "craft lane_depth is 2: one running and one queued; the base slot is the only lane" }
        }
      ]
    },
