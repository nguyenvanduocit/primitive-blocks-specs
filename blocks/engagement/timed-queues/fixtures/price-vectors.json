  "preset": {
    "_comment": "Running items at now. item-run-1 has 7200 seconds left (craft lane 0, schedule_version 1). item-run-2 has 3660 seconds left. Wallet: gems 100, speedup_1h 2.",
    "items": {
      "item-run-1": {
        "queue_id": "craft",
        "slot_index": 0,
        "state": "running",
        "starts_at": "2026-10-21T11:00:00Z",
        "ends_at": "2026-10-21T14:00:00Z",
        "schedule_version": 1
      },
      "item-run-2": {
        "queue_id": "craft",
        "slot_index": 0,
        "state": "running",
        "starts_at": "2026-10-21T10:01:00Z",
        "ends_at": "2026-10-21T13:01:00Z",
        "schedule_version": 1
      },
      "item-run-3": {
        "queue_id": "craft",
        "slot_index": 0,
        "state": "running",
        "starts_at": "2026-10-21T11:00:00Z",
        "ends_at": "2026-10-21T12:05:00Z",
        "schedule_version": 1
      },
      "item-queued-1": {
        "queue_id": "craft",
        "slot_index": 0,
        "state": "queued",
        "starts_at": "2026-10-21T14:00:00Z",
        "ends_at": "2026-10-21T14:15:00Z",
        "schedule_version": 1
      }
    },
    "wallet": {
      "gems": 100,
      "speedup_1h": 2,
      "speedup_5m": 0
    }
  },
  "quote_cases": [
    {
      "name": "quote-two-modes",
      "item": "item-run-1",
      "at": "2026-10-21T12:00:00Z",
      "expected": {
        "remaining_seconds": 7200,
        "quotes": [
          {
            "mode": "finish",
            "price_amount": 31,
            "price_currency": "gems",
            "free": false,
            "valid_until": "2026-10-21T12:01:00Z",
            "ends_at_after": "2026-10-21T12:00:00Z"
          },
          {
            "mode": "step",
            "step_seconds": 3600,
            "price_amount": 11,
            "price_currency": "gems",
            "free": false,
            "valid_until": "2026-10-21T12:01:00Z",
            "ends_at_after": "2026-10-21T13:00:00Z"
          }
        ]
      }
    },
    {
      "name": "charge-is-lower-than-quote",
      "item": "item-run-2",
      "quote_at": "2026-10-21T12:00:00Z",
      "spend_at": "2026-10-21T12:01:00Z",
      "quote": {
        "mode": "finish",
        "remaining_seconds": 3660,
        "price_amount": 21
      },
      "expected": {
        "current_price_at_spend": 20,
        "quoted": 21,
        "charged": 20,
        "ledger": {
          "op": "spend",
          "currency": "gems",
          "amount": 20,
          "reason": "timed-queues.speed-up"
        },
        "item_state": "ready",
        "balance_gems": 80
      }
    },
    {
      "name": "quote-expired-never-charges",
      "item": "item-run-2",
      "quote_at": "2026-10-21T12:00:00Z",
      "spend_at": "2026-10-21T12:01:01Z",
      "expected": {
        "error": "quote_expired",
        "charged": 0,
        "ledger_calls": 0,
        "fresh_quotes": [
          {
            "mode": "finish",
            "remaining_seconds": 3599,
            "price_amount": 20,
            "valid_until": "2026-10-21T12:02:01Z"
          }
        ],
        "balance_gems": 100
      }
    },
    {
      "name": "quote-stale-after-another-device-step",
      "item": "item-run-1",
      "quote_at": "2026-10-21T12:00:00Z",
      "between": {
        "at": "2026-10-21T12:00:30Z",
        "device": "tablet",
        "action": "speed-up step 3600",
        "result": {
          "ends_at": "2026-10-21T13:00:00Z",
          "schedule_version": 2
        }
      },
      "spend_at": "2026-10-21T12:00:40Z",
      "expected": {
        "error": "quote_stale",
        "charged": 0,
        "ledger_calls": 0,
        "fresh_quotes": [
          {
            "mode": "finish",
            "remaining_seconds": 3560,
            "price_amount": 20
          }
        ],
        "note": "no step quote: the 3600-second step is not shorter than the 3560 seconds left"
      }
    },
    {
      "name": "curve-change-cannot-raise-an-open-quote",
      "item": "item-run-2",
      "quote_at": "2026-10-21T12:00:00Z",
      "spend_at": "2026-10-21T12:00:40Z",
      "between": {
        "at": "2026-10-21T12:00:30Z",
        "operator": "publishes SPEEDUP_CURVE [[3600,40],[86400,520],[604800,2000]] with SPEEDUP_PRICE_PER_HOUR_CAP 40"
      },
      "expected": {
        "quoted": 21,
        "current_price_under_new_curve": 41,
        "charged": 21,
        "note": "charge = min(quote, current price) inside valid_until; the new curve applies to new quotes"
      }
    },
    {
      "name": "free-finish-at-threshold",
      "item": "item-run-3",
      "at": "2026-10-21T12:00:00Z",
      "expected": {
        "remaining_seconds": 300,
        "quotes": [
          {
            "mode": "finish",
            "price_amount": 0,
            "free": true
          }
        ],
        "spend": {
          "ledger_calls": 0,
          "reduction_source": "free_finish",
          "item_state": "ready"
        }
      }
    },
    {
      "name": "one-second-above-free-threshold",
      "item": "item-run-3",
      "at": "2026-10-21T11:59:59Z",
      "expected": {
        "remaining_seconds": 301,
        "quotes": [
          {
            "mode": "finish",
            "price_amount": 2,
            "free": false
          }
        ]
      }
    },
    {
      "name": "insufficient-balance",
      "item": "item-run-1",
      "wallet_override": {
        "gems": 10
      },
      "at": "2026-10-21T12:00:00Z",
      "expected": {
        "error": "insufficient_balance",
        "currency": "gems",
        "needed": 31,
        "balance": 10,
        "shortfall": 21,
        "reduction_status": "rejected",
        "quote_consumed": false,
        "item_state": "running"
      }
    },
    {
      "name": "queued-item-has-no-quote",
      "item": "item-queued-1",
      "at": "2026-10-21T12:00:00Z",
      "expected": {
        "error": "item_not_running",
        "charged": 0
      }
    },
    {
      "name": "paid-speedup-off-for-a-flagged-minor",
      "item": "item-run-1",
      "account_override": {
        "is_minor": true
      },
      "at": "2026-10-21T12:00:00Z",
      "expected": {
        "paid_quotes": [],
        "error_on_paid_spend": "paid_speedup_disabled",
        "free_finish_still_offered_when_remaining_at_most_300": true,
        "time_items_still_usable": true
      }
    }
  ],
  "time_item_cases": [
    {
      "name": "two-items-finish-the-item",
      "item": "item-run-1",
      "at": "2026-10-21T12:00:00Z",
      "request": {
        "item_code": "speedup_1h",
        "max_count": 5
      },
      "expected": {
        "used": 2,
        "seconds_applied": 7200,
        "ledger": {
          "op": "spend",
          "currency": "speedup_1h",
          "amount": 2,
          "reason": "timed-queues.speed-up"
        },
        "item_state": "ready",
        "speedup_1h_after": 0
      }
    },
    {
      "name": "one-item-partial",
      "item": "item-run-1",
      "at": "2026-10-21T12:00:00Z",
      "request": {
        "item_code": "speedup_1h",
        "max_count": 1
      },
      "expected": {
        "used": 1,
        "seconds_applied": 3600,
        "ends_at_after": "2026-10-21T13:00:00Z",
        "item_state": "running",
        "speedup_1h_after": 1
      }
    },
    {
      "name": "never-consumes-more-than-needed",
      "item": "item-run-1",
      "at": "2026-10-21T12:30:00Z",
      "ends_at_override": "2026-10-21T13:30:00Z",
      "request": {
        "item_code": "speedup_1h",
        "max_count": 5
      },
      "expected": {
        "remaining_seconds": 3600,
        "used": 1,
        "seconds_applied": 3600,
        "item_state": "ready",
        "speedup_1h_after": 1
      }
    },
    {
      "name": "overshoot-uses-the-rounded-up-count",
      "item": "item-run-1",
      "at": "2026-10-21T12:30:00Z",
      "ends_at_override": "2026-10-21T14:00:00Z",
      "wallet_override": {
        "speedup_1h": 2
      },
      "request": {
        "item_code": "speedup_1h",
        "max_count": 5
      },
      "expected": {
        "remaining_seconds": 5400,
        "used": 2,
        "seconds_applied": 5400,
        "item_state": "ready",
        "speedup_1h_after": 0,
        "note": "ceil(5400 / 3600) = 2 items; the time applied is capped at the remaining 5400 seconds"
      }
    },
    {
      "name": "no-items-owned",
      "item": "item-run-1",
      "at": "2026-10-21T12:00:00Z",
      "wallet_override": {
        "speedup_1h": 0
      },
      "request": {
        "item_code": "speedup_1h",
        "max_count": 1
      },
      "expected": {
        "error": "insufficient_balance",
        "currency": "speedup_1h",
        "needed": 1,
        "balance": 0
      }
    }
  ],
