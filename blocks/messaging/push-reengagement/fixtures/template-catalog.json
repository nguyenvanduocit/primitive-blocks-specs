  "copy_lint_cases": [
    {
      "text": "Don't let your streak die!",
      "violations": [
        "guilt"
      ]
    },
    {
      "text": "Your pet is sad without you",
      "violations": [
        "guilt"
      ]
    },
    {
      "text": "Only 2 left, hurry!",
      "violations": [
        "false_scarcity",
        "fake_urgency"
      ]
    },
    {
      "text": "Last chance to claim your gift",
      "violations": [
        "fake_urgency"
      ],
      "note": "literal deadline words without a time_binding"
    },
    {
      "text": "{event_title} ends in {ends_in}",
      "violations": [],
      "time_binding": "expires_at"
    },
    {
      "text": "A welcome-back gift is ready",
      "violations": []
    },
    {
      "text": "Pick up from your last level whenever you like.",
      "violations": []
    },
    {
      "text": "Your free trial ends on {renewal_date}",
      "violations": [],
      "service_template": true
    },
    {
      "text": "Upgrade now and save 40%",
      "violations": [
        "upsell"
      ],
      "service_template": true
    },
    {
      "text": "Don't lose your VIP perks!",
      "violations": [
        "guilt"
      ],
      "service_template": true
    },
    {
      "text": "Special offer: stay for half price",
      "violations": [
        "upsell"
      ],
      "service_template": true
    }
  ],
  "copy_rules": {
    "guilt_patterns": [
      "don't let",
      "let down",
      "abandon",
      "is sad",
      "is lonely",
      "is crying",
      "misses you so much",
      "don't lose"
    ],
    "fake_urgency_patterns": [
      "last chance",
      "hurry",
      "act now",
      "expires soon",
      "don't miss out"
    ],
    "false_scarcity_patterns": [
      "only \\d+ left",
      "almost gone",
      "selling fast"
    ],
    "upsell_patterns": [
      "upgrade",
      "discount",
      "% off",
      "special offer",
      "limited offer",
      "best value",
      "exclusive deal",
      "save \\d+"
    ]
  },
