{
  "_comment": "Template catalog and copy-rule cases. Copy is English placeholder text; the `de` entries are marked placeholders, real translations belong to the adopter. Template syntax is in templates._syntax. A template may name a reward only if its step carries one; a template may state a deadline only through `{ends_in}` bound to a server `ends_at` (time_binding). Service templates (category subscription) also pass the upsell lint (copy_rules.upsell_patterns) and must state the price after the trial and the renewal date.",
  "templates": {
    "_syntax": {
      "required": "{name} is a required variable; when it is absent the intent is suppressed with template_error",
      "optional": "[[ ... ]] is an optional segment; it is omitted whole, with its own spaces, when any variable inside it is absent",
      "declared": "a template names only variables listed in vars (required) or optional_vars; each is an emitter param listed in config-defaults.json event_routes[].params or a derived variable described in derived_vars; emitter params the template does not name are ignored"
    },
    "timers.energy_full": {
      "category": "timers",
      "vars": [],
      "copy": {
        "en": {
          "title": "Energy is full",
          "body": "Your energy is at the maximum. Ready when you are."
        },
        "de": {
          "title": "[de] Energy is full",
          "body": "[de] Your energy is at the maximum. Ready when you are."
        }
      },
      "optional_vars": [],
      "params_used": []
    },
    "timers.queue_item_ready": {
      "category": "timers",
      "vars": [],
      "copy": {
        "en": {
          "title": "A timer has finished",
          "body": "Something is ready to collect."
        }
      },
      "optional_vars": [],
      "params_used": []
    },
    "streak.at_risk": {
      "category": "streak",
      "vars": [
        "streak_length"
      ],
      "optional_vars": [
        "reward_amount",
        "reward_name"
      ],
      "params_used": [
        "streak_length",
        "reward_amount",
        "reward_code"
      ],
      "derived_vars": {
        "reward_name": "the localized display name of reward_code from the adopter's item catalog; absent when the code is unknown or reward_code is absent"
      },
      "copy": {
        "en": {
          "title": "Your {streak_length}-day streak",
          "body": "Play once today to keep it going.[[ Today's reward: {reward_amount} {reward_name}.]]"
        },
        "en-GB": {
          "title": "Your {streak_length}-day streak",
          "body": "Play once today to keep it going.[[ Today's reward: {reward_amount} {reward_name}.]]"
        }
      }
    },
    "events.ending_soon": {
      "category": "events",
      "vars": [
        "event_title",
        "ends_in"
      ],
      "optional_vars": [],
      "params_used": [
        "event_title"
      ],
      "derived_vars": {
        "ends_in": "expires_at minus the send instant, rendered in the locale"
      },
      "time_binding": "expires_at",
      "copy": {
        "en": {
          "title": "{event_title} ends in {ends_in}",
          "body": "There is still time to collect the event rewards."
        }
      }
    },
    "rewards.ready": {
      "category": "rewards",
      "vars": [],
      "optional_vars": [],
      "params_used": [],
      "copy": {
        "en": {
          "title": "A reward is ready",
          "body": "Open the game to collect it."
        }
      },
      "note": "the copy never says or implies that the reward expires; the emitter's expires_at only ends the reminder"
    },
    "comeback.reminder": {
      "category": "comeback",
      "vars": [],
      "copy": {
        "en": {
          "title": "Your game is where you left it",
          "body": "Pick up from your last level whenever you like."
        }
      },
      "optional_vars": [],
      "params_used": []
    },
    "comeback.gift": {
      "category": "comeback",
      "vars": [
        "reward_amount",
        "reward_name"
      ],
      "requires_reward": true,
      "copy": {
        "en": {
          "title": "A welcome-back gift is ready",
          "body": "{reward_amount} {reward_name} are waiting for your next visit."
        }
      },
      "optional_vars": [],
      "params_used": [],
      "derived_vars": {
        "reward_amount": "the ladder step's reward amount",
        "reward_name": "display name of the step's reward currency"
      }
    },
    "comeback.update": {
      "category": "comeback",
      "vars": [],
      "copy": {
        "en": {
          "title": "There is something new to try",
          "body": "New content arrived since your last visit."
        }
      },
      "optional_vars": [],
      "params_used": []
    },
    "comeback.final": {
      "category": "comeback",
      "vars": [
        "reward_amount",
        "reward_name"
      ],
      "requires_reward": true,
      "copy": {
        "en": {
          "title": "A welcome-back gift is ready",
          "body": "{reward_amount} {reward_name} are waiting whenever you return. This is our last reminder."
        }
      },
      "optional_vars": [],
      "params_used": [],
      "derived_vars": {
        "reward_amount": "the ladder step's reward amount",
        "reward_name": "display name of the step's reward currency"
      }
    },
    "subscription.trial_ending": {
      "category": "subscription",
      "service_notice": true,
      "vars": [
        "renewal_date"
      ],
      "optional_vars": [
        "price_text"
      ],
      "params_used": [
        "renews_at",
        "price_milliunits",
        "currency_code",
        "period"
      ],
      "derived_vars": {
        "renewal_date": "renews_at (the first charge date) as a long date in the profile locale and timezone",
        "price_text": "price_milliunits divided by 1000, formatted as currency_code in the profile locale, followed by a period phrase when period is P1W (per week), P1M (per month), P2M, P3M or P6M (every N months) or P1Y (per year); absent when price_milliunits or currency_code is absent"
      },
      "copy": {
        "en": {
          "title": "Your free trial ends on {renewal_date}",
          "body": "[[About {price_text} after that. ]]The exact amount, which taxes can change, is on the store screen. Manage or cancel in Settings."
        },
        "en-GB": {
          "title": "Your free trial ends on {renewal_date}",
          "body": "[[About {price_text} after that. ]]The exact amount, which taxes can change, is on the store screen. Manage or cancel in Settings."
        }
      }
    }
  },
  "locale_resolution_cases": [
