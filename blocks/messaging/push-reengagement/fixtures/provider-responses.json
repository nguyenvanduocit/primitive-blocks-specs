{
  "_comment": "Provider responses and the action the block takes. Status codes, reason strings and error codes are the documented ones (README section 3, facts P15 to P25). `token_registered_at` is the device_tokens.last_registered_at of the row that was targeted. Timestamps in APNs 410 bodies are milliseconds since epoch. Delays are the documented minimums; implementations add jitter on top.",
  "apns": [
    { "id": "A01-accepted", "http_status": 200, "body": null, "expect": { "delivery": "sent", "token": "keep" } },
    { "id": "A02-unregistered-after-registration", "http_status": 410, "body": { "reason": "Unregistered", "timestamp": 1792490400000 }, "timestamp_iso": "2026-10-20T10:00:00Z", "token_registered_at": "2026-10-18T05:00:00Z",
      "expect": { "delivery": "failed", "token": "deactivate", "inactive_reason": "provider_unregistered", "retry": false } },
    { "id": "A03-unregistered-but-registered-later", "http_status": 410, "body": { "reason": "Unregistered", "timestamp": 1792490400000 }, "timestamp_iso": "2026-10-20T10:00:00Z", "token_registered_at": "2026-10-21T09:00:00Z",
      "expect": { "delivery": "failed", "token": "keep", "retry": false } },
    { "id": "A04-expired-token", "http_status": 410, "body": { "reason": "ExpiredToken", "timestamp": 1792490400000 }, "timestamp_iso": "2026-10-20T10:00:00Z", "token_registered_at": "2026-10-18T05:00:00Z",
      "expect": { "delivery": "failed", "token": "deactivate", "inactive_reason": "provider_unregistered", "retry": false } },
    { "id": "A05-bad-device-token", "http_status": 400, "body": { "reason": "BadDeviceToken" },
      "expect": { "delivery": "failed", "token": "deactivate", "inactive_reason": "bad_token", "retry": false, "counts_toward_breaker": true } },
    { "id": "A06-token-not-for-topic", "http_status": 400, "body": { "reason": "DeviceTokenNotForTopic" },
      "expect": { "delivery": "failed", "token": "deactivate", "inactive_reason": "bad_token", "retry": false, "counts_toward_breaker": true } },
    { "id": "A07-expired-provider-token", "http_status": 403, "body": { "reason": "ExpiredProviderToken" },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "action": "refresh_provider_jwt_then_retry_once", "counts_toward_breaker": true } },
    { "id": "A08-too-many-provider-token-updates", "http_status": 429, "body": { "reason": "TooManyProviderTokenUpdates" },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "action": "keep_current_provider_jwt_no_refresh_for_20_minutes" } },
    { "id": "A09-too-many-requests", "http_status": 429, "body": { "reason": "TooManyRequests" },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "action": "retry_with_delay" } },
    { "id": "A10-payload-too-large", "http_status": 413, "body": { "reason": "PayloadTooLarge" },
      "expect": { "delivery": "failed", "token": "keep", "retry": false, "action": "alert_template_defect" } },
    { "id": "A11-service-unavailable", "http_status": 503, "body": { "reason": "ServiceUnavailable" },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "min_delay_seconds": 900 } },
    { "id": "A12-shutdown", "http_status": 503, "body": { "reason": "Shutdown" },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "min_delay_seconds": 900, "action": "open_new_connection" } },
    { "id": "A13-internal-server-error", "http_status": 500, "body": { "reason": "InternalServerError" },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "min_delay_seconds": 900 } }
  ],
  "fcm": [
    { "id": "F01-accepted", "http_status": 200, "body": { "name": "projects/example-project/messages/0:1792500000000000%abc" }, "expect": { "delivery": "sent", "token": "keep", "provider_message_id": "projects/example-project/messages/0:1792500000000000%abc" } },
    { "id": "F02-unregistered", "http_status": 404, "body": { "error": { "code": 404, "status": "NOT_FOUND", "details": [ { "@type": "type.googleapis.com/google.firebase.fcm.v1.FcmError", "errorCode": "UNREGISTERED" } ] } },
      "expect": { "delivery": "failed", "token": "deactivate", "inactive_reason": "provider_unregistered", "retry": false } },
    { "id": "F03-invalid-argument-invalid-token", "http_status": 400, "body": { "error": { "code": 400, "message": "The registration token is not a valid FCM registration token", "status": "INVALID_ARGUMENT", "details": [ { "@type": "type.googleapis.com/google.firebase.fcm.v1.FcmError", "errorCode": "INVALID_ARGUMENT" } ] } },
      "expect": { "delivery": "failed", "token": "deactivate", "inactive_reason": "bad_token", "retry": false } },
    { "id": "F04-invalid-argument-payload", "http_status": 400, "body": { "error": { "code": 400, "message": "Invalid value at 'message.data[0].value' (TYPE_STRING), 12", "status": "INVALID_ARGUMENT", "details": [ { "@type": "type.googleapis.com/google.rpc.BadRequest", "fieldViolations": [ { "field": "message.data[0].value", "description": "Invalid value at 'message.data[0].value' (TYPE_STRING), 12" } ] } ] } },
      "expect": { "delivery": "failed", "token": "keep", "retry": false, "action": "alert_template_defect" } },
    { "id": "F05-sender-id-mismatch", "http_status": 403, "body": { "error": { "code": 403, "status": "PERMISSION_DENIED", "details": [ { "@type": "type.googleapis.com/google.firebase.fcm.v1.FcmError", "errorCode": "SENDER_ID_MISMATCH" } ] } },
      "expect": { "delivery": "failed", "token": "deactivate", "inactive_reason": "sender_mismatch", "retry": false, "counts_toward_breaker": true } },
    { "id": "F06-third-party-auth-error", "http_status": 401, "body": { "error": { "code": 401, "status": "UNAUTHENTICATED", "details": [ { "@type": "type.googleapis.com/google.firebase.fcm.v1.FcmError", "errorCode": "THIRD_PARTY_AUTH_ERROR" } ] } },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "action": "pause_ios_via_fcm_lane_and_alert", "counts_toward_breaker": true } },
    { "id": "F07-quota-exceeded-with-retry-after", "http_status": 429, "headers": { "Retry-After": "120" }, "body": { "error": { "code": 429, "status": "RESOURCE_EXHAUSTED", "details": [ { "@type": "type.googleapis.com/google.firebase.fcm.v1.FcmError", "errorCode": "QUOTA_EXCEEDED" } ] } },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "min_delay_seconds": 120 } },
    { "id": "F08-quota-exceeded-no-header", "http_status": 429, "headers": {}, "body": { "error": { "code": 429, "status": "RESOURCE_EXHAUSTED", "details": [ { "@type": "type.googleapis.com/google.firebase.fcm.v1.FcmError", "errorCode": "QUOTA_EXCEEDED" } ] } },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "min_delay_seconds": 60 } },
    { "id": "F09-unavailable-with-retry-after", "http_status": 503, "headers": { "Retry-After": "30" }, "body": { "error": { "code": 503, "status": "UNAVAILABLE", "details": [ { "@type": "type.googleapis.com/google.firebase.fcm.v1.FcmError", "errorCode": "UNAVAILABLE" } ] } },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "min_delay_seconds": 30 } },
    { "id": "F10-internal", "http_status": 500, "body": { "error": { "code": 500, "status": "INTERNAL", "details": [ { "@type": "type.googleapis.com/google.firebase.fcm.v1.FcmError", "errorCode": "INTERNAL" } ] } },
      "expect": { "delivery": "queued", "token": "keep", "retry": true, "min_delay_seconds": 10, "backoff": "exponential_with_jitter" } }
  ],
  "breaker_cases": [
    { "id": "B01-trips", "provider": "apns", "attempts_in_window": 60, "config_class_errors": 15, "expect": { "paused": true, "tokens_deactivated_in_window": 0, "note": "15 of 60 is 25 percent, above 20 percent with at least 50 attempts: pause, and undo any deactivation made on config-class errors in the window" } },
    { "id": "B02-below-sample", "provider": "apns", "attempts_in_window": 20, "config_class_errors": 10, "expect": { "paused": false } },
    { "id": "B03-below-ratio", "provider": "fcm", "attempts_in_window": 200, "config_class_errors": 10, "expect": { "paused": false } }
  ]
}
